{
  "name": "hizli-kasa",
  "productName": "Hizli Kasa",
  "version": "1.18.0",
  "description": "Barkodlu hızlı satış kasası - çevrimdışı çalışır, buluta senkronize olur",
  "main": "main.js",
  "author": "Sirket",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish always",
    "build:web": "node scripts/build-web.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@zxing/library": "^0.21.0"
  },
  "build": {
    "appId": "com.sirket.hizlikasa",
    "productName": "Hizli Kasa",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hızlı Kasa",
      "deleteAppDataOnUninstall": false,
      "artifactName": "HizliKasa-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "meliksahenisozkaya",
        "repo": "hizli-kasa",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "xlsx": "0.18.5",
    "electron-updater": "^6.3.9"
  }
}
